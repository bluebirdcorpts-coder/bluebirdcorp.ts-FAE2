# === Bluebird B-APO Environment Configuration ===

# App
APP_NAME=Bluebird B-APO
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=8192

# Database
DATABASE_URL=sqlite+aiosqlite:///./bluebird_apo.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/bluebird_apo

# Vector DB (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=bluebird_products

# Redis (Task Queue)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
